{
  "name": "pixel-drift",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Sprite-stacked pixel-art racing game",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5180",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5181",
    "assets": "node scripts/gen-assets.mjs",
    "track": "node scripts/gen-track.mjs",
    "api": "node server/api.mjs",
    "test": "node --test server/anticheat.test.mjs && node scripts/car-stats.check.mjs"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
